# The RCDATA resources of the Windows .rc files as a table of embedded files,
# for the FindResource/LoadResource/LockResource of src/platform/win32_posix.cpp
# on platforms without Windows resources (Android).
#
#   brokenbond_resource_table(<output .cpp> <rc file>...)
#
# Each "<id> RCDATA "<file>"" line of the given .rc files (paths relative to
# the .rc file) becomes an entry; .rc files and resource files that do not
# exist are skipped (the title screen extra and the Hokage portraits are local
# additions). The data is embedded with #embed (the Clang of NDK r29 or newer).
include_guard(GLOBAL)

function(brokenbond_resource_table output)
  set(declarations "")
  set(entries "")
  set(depends "")
  foreach(rc IN LISTS ARGN)
    if(NOT EXISTS "${rc}")
      continue()
    endif()
    get_filename_component(rc_dir "${rc}" DIRECTORY)
    file(STRINGS "${rc}" lines REGEX "^[ \t]*[0-9]+[ \t]+RCDATA[ \t]+\"")
    foreach(line IN LISTS lines)
      if(NOT line MATCHES "^[ \t]*([0-9]+)[ \t]+RCDATA[ \t]+\"([^\"]+)\"")
        continue()
      endif()
      set(id "${CMAKE_MATCH_1}")
      set(file "${CMAKE_MATCH_2}")
      if(NOT IS_ABSOLUTE "${file}")
        get_filename_component(file "${rc_dir}/${file}" ABSOLUTE)
      endif()
      if(NOT EXISTS "${file}")
        continue()
      endif()
      string(APPEND declarations "alignas(16) const unsigned char kResource${id}[] = {\n#embed \"${file}\"\n};\n")
      string(APPEND entries "    {${id}, kResource${id}, sizeof(kResource${id})},\n")
      list(APPEND depends "${file}")
    endforeach()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${rc}")
  endforeach()
  # Built with string(APPEND): a list would split the C++ at its semicolons.
  set(text "// Generated by tools/android/resources.cmake - do not edit.\n#include <cstddef>\n\n")
  string(APPEND text "namespace win32_posix {\n")
  string(APPEND text "struct ResourceEntry {\n  int id;\n  const unsigned char* data;\n  size_t size;\n};\n")
  string(APPEND text "extern const ResourceEntry kResources[];\n")
  string(APPEND text "namespace {\n${declarations}}  // namespace\n")
  string(APPEND text "const ResourceEntry kResources[] = {\n${entries}    {0, nullptr, 0},\n};\n")
  string(APPEND text "}  // namespace win32_posix\n")
  file(CONFIGURE OUTPUT "${output}" CONTENT "${text}" @ONLY)
  set_source_files_properties("${output}" PROPERTIES
      COMPILE_OPTIONS "-Wno-c23-extensions"
      OBJECT_DEPENDS "${depends}")
endfunction()
