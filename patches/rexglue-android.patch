diff --git a/src/core/main_android.cpp b/src/core/main_android.cpp
new file mode 100644
index 0000000..11c83e0
--- /dev/null
+++ b/src/core/main_android.cpp
@@ -0,0 +1,55 @@
+/**
+ * @file        core/main_android.cpp
+ * @brief       Android process-level helpers
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/main_android.h>
+
+#include <android/api-level.h>
+
+#include <cstdlib>
+#include <mutex>
+#include <system_error>
+
+#include <rex/filesystem.h>
+#include <rex/memory/utils.h>
+#include <rex/thread.h>
+
+namespace rex {
+
+int GetAndroidApiLevel() {
+  static const int api_level = android_get_device_api_level();
+  return api_level;
+}
+
+namespace {
+std::once_flag android_initialized;
+}  // namespace
+
+void InitializeAndroid() {
+  std::call_once(android_initialized, [] {
+    rex::memory::AndroidInitialize();
+    rex::thread::AndroidInitialize();
+    rex::filesystem::AndroidInitialize();
+  });
+}
+
+void ShutdownAndroid() {
+  rex::filesystem::AndroidShutdown();
+  rex::thread::AndroidShutdown();
+  rex::memory::AndroidShutdown();
+}
+
+std::filesystem::path GetAndroidDataFolder() {
+  if (const char* dir = std::getenv("REX_ANDROID_DATA_DIR"); dir && *dir) {
+    return std::filesystem::path(dir);
+  }
+  std::error_code ec;
+  auto cwd = std::filesystem::current_path(ec);
+  return ec ? std::filesystem::path(".") : cwd;
+}
+
+}  // namespace rex
