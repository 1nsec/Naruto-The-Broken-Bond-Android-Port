@@ -0,0 +1,40 @@
+/**
+ * @file        main_android.h
+ * @brief       Android process-level helpers (API level, one-time setup)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * @remarks     On Android the app runs inside the Java process started by the
+ *              system. SDL's SDLActivity loads the native libraries and calls
+ *              SDL_main on its own thread; InitializeAndroid() is called from
+ *              there, before the runtime creates memory mappings or threads.
+ */
+
+#pragma once
+
+#include <filesystem>
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_ANDROID
+
+namespace rex {
+
+// The API level of the device (android_get_device_api_level()).
+int GetAndroidApiLevel();
+
+// Resolves the optional, dynamically loaded functions of the memory, thread
+// and filesystem layers. Safe to call more than once.
+void InitializeAndroid();
+void ShutdownAndroid();
+
+// The folder that plays the role of the executable's folder on desktop
+// platforms: settings (<app>.toml), saves (hdd/), logs and caches live there.
+// Set by the Java side through the REX_ANDROID_DATA_DIR environment variable;
+// falls back to the current directory.
+std::filesystem::path GetAndroidDataFolder();
+
+}  // namespace rex
+
+#endif  // REX_PLATFORM_ANDROID
