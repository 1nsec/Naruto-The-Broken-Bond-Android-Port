+#if REX_PLATFORM_ANDROID
+void AndroidInitialize() {}
+void AndroidShutdown() {}
+
+// The launcher hands files picked through the Storage Access Framework over as
+// file descriptors that it opened (fd:<n>, or the /proc/self/fd/<n> path, which
+// is usable as a plain path too). content:// URIs themselves need the Java
+// ContentResolver and are not opened here.
+bool IsAndroidContentUri(const std::string_view source) {
+  return source.starts_with("content://") || source.starts_with("fd:");
+}
+
+int OpenAndroidContentFileDescriptor(const std::string_view uri, const char* mode) {
+  if (!uri.starts_with("fd:")) {
+    return -1;
+  }
+  int fd = -1;
+  try {
+    fd = std::stoi(std::string(uri.substr(3)));
+  } catch (...) {
+    return -1;
+  }
+  if (fd < 0) {
+    return -1;
+  }
+  // The caller owns the returned descriptor.
+  int flags = O_CLOEXEC;
+  flags |= (mode && std::string_view(mode).find('w') != std::string_view::npos) ? O_RDWR : O_RDONLY;
+  return open(("/proc/self/fd/" + std::to_string(fd)).c_str(), flags);
+}
+#endif  // REX_PLATFORM_ANDROID
+
 }  // namespace filesystem
 }  // namespace rex
