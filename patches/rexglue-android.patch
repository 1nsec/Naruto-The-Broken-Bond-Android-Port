+      return;
+    }
+    if (original->sa_handler != SIG_DFL && original->sa_handler != SIG_IGN && original->sa_handler) {
+      original->sa_handler(signal_number);
+      return;
+    }
+  }
+  signal(signal_number, SIG_DFL);
