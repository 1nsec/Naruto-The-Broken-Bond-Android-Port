<?xml version="1.0" encoding="utf-8"?>
<!-- A link chip of the launcher, under Play: ink with a parchment rim. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#FF3A2A1C" />
            <stroke android:width="1dp" android:color="#FFF4E7C9" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#CC1B1410" />
            <stroke android:width="1dp" android:color="#99D8C096" />
        </shape>
    </item>
</selector>
