<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher: the game's logo, Play and the disc on the left; quick settings and shortcuts
     on the right (built by LauncherActivity), over an animated background, under the effects
     (smoke, kunai and shuriken). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <org.brokenbond.port.ChakraBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.85"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:maxHeight="150dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo" />

            <Button
                android:id="@+id/play"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_play"
                android:elevation="6dp"
                android:letterSpacing="0.25"
                android:stateListAnimator="@null"
                android:text="@string/play"
                android:textAllCaps="true"
                android:shadowColor="#FF3E0A05"
                android:shadowDy="2"
                android:shadowRadius="3"
                android:textColor="#FFF4E7C9"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Who made the port, and where to follow him, under Play. -->
            <TextView
                android:id="@+id/credit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:letterSpacing="0.04"
                android:padding="2dp"
                android:shadowColor="#CCE0501E"
                android:shadowRadius="14"
                android:text="@string/credit"
                android:textColor="#FFF4E7C9"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/youtube"
                    style="@style/LauncherChip"
                    android:text="@string/link_youtube" />

                <TextView
                    android:id="@+id/instagram"
                    style="@style/LauncherChip"
                    android:layout_marginStart="8dp"
                    android:text="@string/link_instagram" />
            </LinearLayout>

            <TextView
                android:id="@+id/pick_iso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:ellipsize="middle"
                android:gravity="center"
                android:maxLines="2"
                android:padding="4dp"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#80A89A8C"
                android:textSize="11sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="20dp"
            android:layout_weight="1.15"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/alpha_badge"
                    android:textColor="#FFD8C096"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <org.brokenbond.port.EffectsView
        android:id="@+id/effects"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
